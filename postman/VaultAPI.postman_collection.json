{
  "info": {
    "name": "VaultAPI",
    "_postman_id": "2b9c5a90-3c3b-4e4a-a1b8-vaultapi",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key":"baseUrl","value":"http://localhost:3000"},
    {"key":"apiKey","value":""}
  ],
  "item": [
    {
      "name":"Health",
      "request":{"method":"GET","url":"{{baseUrl}}/health"}
    },
    {
      "name":"Protected Demo",
      "request":{
        "method":"GET",
        "header":[{"key":"X-API-Key","value":"{{apiKey}}"}],
        "url":"{{baseUrl}}/api/v1/demo/data"
      }
    },
    {
      "name":"Audit",
      "request":{
        "method":"GET",
        "header":[{"key":"X-API-Key","value":"{{apiKey}}"}],
        "url":"{{baseUrl}}/api/v1/audit?limit=50"
      }
    },
    {
      "name":"Reports",
      "request":{
        "method":"GET",
        "header":[{"key":"X-API-Key","value":"{{apiKey}}"}],
        "url":"{{baseUrl}}/api/v1/reports"
      }
    }
  ]
}
